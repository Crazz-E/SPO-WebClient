{
  "permissions": {
    "additionalDirectories": [
      "~/SPO-Original",
      "~/SPO-ASP"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npm outdated*)",
      "Bash(node *)",
      "Bash(npx tsc*)",
      "Bash(npx jest*)",
      "Bash(npx vite*)",
      "Bash(npx esbuild*)",
      "Bash(npx playwright*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git remote*)",
      "Bash(git config*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git rev-parse*)",
      "Bash(git describe*)",
      "Bash(git cherry-pick*)",
      "Bash(git apply*)",
      "Bash(git format-patch*)",
      "Bash(git am*)",
      "Bash(git bisect*)",
      "Bash(git submodule*)",
      "Bash(git worktree*)",
      "Bash(git reflog*)",
      "Bash(git reset*)",
      "Bash(ls *)",
      "Bash(pwd*)",
      "Bash(cd *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(gh api rate_limit*)",
      "Bash(gh api repos/Crazz-Org/SPO-WebClient/pulls*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment*)",
      "Bash(gh project item-edit*)",
      "Bash(gh project item-add*)",
      "Bash(gh auth status*)",
      "mcp__ccd_session_mgmt__set_session_title"
    ],
    "deny": [
      "Workflow",
      "Bash(git clean*)",
      "Bash(git rm -rf*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git gc --prune*)",
      "Bash(git prune*)",
      "Bash(git reflog expire*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-router.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/journal-writes.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sanctuarize.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-gate.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/verdict-pipe-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/bench-port-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/item-list-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/poll-loop-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/main-commit-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/driver-scope-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/worktree-scope-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/investigation-form-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/file-discovery-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/driver-scope-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/worktree-scope-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/spawn-path-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
