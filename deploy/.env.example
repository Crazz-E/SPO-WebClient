# SPO-WebClient Production Environment
# Copy to project root as .env and chmod 600

NODE_ENV=production
PORT=8080

# Server listen host (default: 0.0.0.0)
HOST=0.0.0.0

# SECURITY KILL SWITCH: disables origin validation, per-IP rate limits, auth rate
# limiting, and per-IP WS connection caps. Dev/test only — never set true in production.
SINGLE_USER_MODE=false

# Enable in-app bug report capture via the /api/bug-report endpoint (optional)
SPO_BUG_REPORT=false

# Game server directory (official SPO servers)
RDO_DIR_HOST=www.starpeaceonline.com

# Terrain/object asset CDN (Cloudflare R2)
CHUNK_CDN_URL=https://spo.zz.works

# ── RDO protocol tuning (opt-in features, default all false) ────────
# Send ObjectsInArea + SegmentsInArea concurrently (saves ~100ms per map refresh)
RDO_PARALLEL_AREA_READS=false

# Populate the world connection pool. The reference client does not do this;
# leave off for conformity with it.
RDO_WORLD_POOL=false

# RDO error handling: observe | reject-except-stale (default) | reject
RDO_ERROR_CONTRACT=reject-except-stale

# Logging: debug | info | warn | error
# WARNING: debug level may log session IDs — use info in production
LOG_LEVEL=info
# NDJSON structured log file (persisted via volume mount in docker-compose)
LOG_FILE=logs/gateway.ndjson
LOG_JSON=true
# Separate error-only log for fast triage (includes recent context per error)
LOG_ERROR_FILE=logs/errors.ndjson

# Log rotation (file-based logging only)
# Max log file size in bytes before rotation (default: 10 MB = 10485760)
LOG_MAX_SIZE=10485760
# Max rotated log files to keep (default: 5)
LOG_MAX_FILES=5
# Ring buffer size for error context in logs (default: 20)
LOG_RING_BUFFER_SIZE=20

# Required when behind nginx reverse proxy (correct IP for rate limiting)
TRUST_PROXY=true

# Enable HSTS header (only set true when serving over HTTPS)
ENABLE_HSTS=true

# Comma-separated GM usernames for broadcast chat (optional)
SPO_GM_USERS=

# Force all players into a specific world (test phase, optional)
# Format: zoneId/worldName — zones: beta, free, restricted
# Example: free/planitia  (note: shamba/planitia/zorcon live under 'free'; 'beta' only has aries)
# Remove or leave empty to restore normal zone/world selection
SPO_FORCE_WORLD=

# ── Cache Sync Service ──────────────────────────────────────────────
# Cache sync mode: 'inline' (default, in-process) or 'external' (separate container)
# Set to 'external' in docker-compose when using spo-cache-sync sidecar
CACHE_SYNC_MODE=external

# Re-sync interval in ms (default: 3600000 = 1 hour). Only used by spo-cache-sync container.
CACHE_SYNC_INTERVAL_MS=3600000

# Set to 'true' to exit after first sync (useful for CI/init containers)
# CACHE_SYNC_ONCE=false

# Dev only: skip remote sync when cache/ already has content (faster restarts)
# CACHE_SKIP_SYNC=true

# ── Advanced: Asset cache location ──────────────────────────────────
# Override the asset cache directory (absolute or relative path, optional)
SPO_CACHE_DIR=
